#!/bin/bash --login
#SBATCH --job-name=e026_predflip
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=leespen1@msu.edu
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=16G
#SBATCH --partition=general-short
#SBATCH --time=01:00:00
#SBATCH --array=1-6
#SBATCH --output=log_e026_%a_%A.log
#SBATCH --export=NONE

module purge
export PATH=/mnt/home/leespen1/.juliaup/bin:${PATH}
unset LD_LIBRARY_PATH
export JULIA_NUM_THREADS=$SLURM_CPUS_PER_TASK

echo "Node: $(hostname)  Date: $(date)  Task: $SLURM_ARRAY_TASK_ID"

REPO=/mnt/home/leespen1/GRIPS/QOKit
# --gcthreads=1: task 3 hit a parallel-GC-marking abort under allocation churn
julia --gcthreads=1 --project="$REPO" "$REPO/research/experiments/026_predicted-flip/run.jl"
