#!/bin/bash --login
#SBATCH --job-name=e018_transfer
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=leespen1@msu.edu
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=8G
#SBATCH --partition=general-short
#SBATCH --time=00:45:00
#SBATCH --output=log_e018_%j.log
#SBATCH --export=NONE

module purge
export PATH=/mnt/home/leespen1/.juliaup/bin:${PATH}
unset LD_LIBRARY_PATH
export JULIA_NUM_THREADS=$SLURM_CPUS_PER_TASK

echo "Node: $(hostname)  Date: $(date)"

REPO=/mnt/home/leespen1/GRIPS/QOKit
julia --project="$REPO" "$REPO/research/experiments/018_transfer-calibration/run.jl"
